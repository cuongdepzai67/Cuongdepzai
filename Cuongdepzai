    local filterText = SearchBox.Text:lower()
    local count = 0

    for _, s in ipairs(servers) do
        local match = true
        if filterText ~= "" then
            local infoStr = (s.playing .. " " .. s.ping):lower()
            if not infoStr:find(filterText, 1, true) then
                match = false
            end
        end

        if match then
            count = count + 1
            local row = Instance.new("TextButton")
            row.Size = UDim2.new(1, 0, 0, 48)
            row.BackgroundColor3 = Color3.fromRGB(16, 20, 30)
            row.Text = ""
