local function scanAndLoad()
    if isScanning then return end
    isScanning = true

    task.spawn(function()
        cachedServers = fetchServers()

        if #cachedServers > 0 then
            StatusLabel.Text = "Đã quét xong! Thấy " .. #cachedServers .. " server lý tưởng"
            renderServerRows(cachedServers)

            if autoHopActive and not isHopping then
                isHopping = true
                local best = cachedServers[1]
                StatusLabel.Text = "Auto-Hop → " .. best.playing .. " người | Ping " .. best.ping
                notify("Auto-Hop: " .. best.playing .. " người")
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, best.id, LocalPlayer)
                end)
                task.wait(1.2)
                isHopping = false
            end
        else
            StatusLabel.Text = "Hết server trống, đang quét lại..."
            if autoHopActive then
                task.wait(2)
                isScanning = false
                scanAndLoad()
                return
            end
        end
        isScanning = false
    end)
end

