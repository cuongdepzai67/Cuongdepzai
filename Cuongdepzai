local function fetchServers()
    local list = {}
    local cursor = ""
    StatusLabel.Text = "Đang quét sâu API Roblox (Tối ưu 10.5)..."

    for i = 1, Settings.MaxPages do
        local url = string.format(
            "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&cursor=%s",
            game.PlaceId, cursor
        )

        local ok, res = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)

        if ok and res and res.data then
            for _, s in ipairs(res.data) do
                if s.id ~= game.JobId and s.playing then
                    local valid = false
                    if Settings.ScanMode == "Solo" then
                        valid = (s.playing == 1)
                    elseif Settings.ScanMode == "Low" then
                        valid = (s.playing >= 1 and s.playing <= 4)
                    elseif Settings.ScanMode == "Ping" then
                        valid = (s.ping and s.ping < 110)
                    else
                        valid = true
                    end

                    if valid then
                        table.insert(list, {
                            id = s.id,
                            playing = s.playing,
                            maxPlayers = s.maxPlayers or 12,
                            ping = s.ping or 120
                        })
                    end
                end
            end

            if res.nextPageCursor and res.nextPageCursor ~= "null" and res.nextPageCursor ~= "" then
                cursor = res.nextPageCursor
            else
                break
            end
        else
            task.wait(0.2) -- Tự động nghỉ tránh Rate Limit 429
        end
        task.wait(0.01)
    end

    table.sort(list, function(a, b)
        if a.playing ~= b.playing then
            return a.playing < b.playing
        end
        return a.ping < b.ping
    end)

    return list
end

local function renderServerRows(servers)
